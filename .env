# Defaults for the placeholders in index.html (Vite replaces %VITE_*% at build).
# Override per panel from the environment — scripts/build_panel.sh does this from
# the panel's areas.json (or its --aircraft / --title / --favicon options):
#   VITE_PANEL_TITLE="D-ETES Instrument Panel" npm run build
VITE_PANEL_TITLE=Instrument Panel
VITE_PANEL_FAVICON=favicon.svg
